# ShortsPilot - YouTube Shorts Autopilot System Environment Configuration
# Configure these secrets in the AI Studio Secrets panel (or .env for local/server runs).
# Never hardcode API keys in source code.

# Primary AI Provider (options: openrouter, gemini, local_heuristic)
AI_PROVIDER=openrouter

# OpenRouter API Key (supports free models like meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free)
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

# Gemini API Key (Fallback or primary AI provider for script & hook analysis)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Official YouTube Data API v3 Key (for public trend research, Shorts search & competitor analysis)
YOUTUBE_API_KEY=MY_YOUTUBE_API_KEY

# Official YouTube OAuth 2.0 Credentials (for uploading 9:16 Shorts & reading YouTube Analytics API)
YOUTUBE_CLIENT_ID=MY_YOUTUBE_OAUTH_CLIENT_ID
YOUTUBE_ACCESS_TOKEN=MY_YOUTUBE_OAUTH_ACCESS_TOKEN
